async def safe_edit_message(
    callback: CallbackQuery,
    text: str,
    reply_markup: InlineKeyboardMarkup | None = None,
    parse_mode: str = "HTML",
) -> None:
    if callback.message is None:
        return

    try:
        await callback.message.edit_text(
            text=text,
            parse_mode=parse_mode,
            reply_markup=reply_markup,
        )

    except TelegramBadRequest as error:
        if "message is not modified" in str(error).lower():
            return

        logger.exception(
            "Ошибка редактирования сообщения"
        )
        raise


# =========================
# ПРОВЕРКА COOLDOWN
# =========================

async def check_callback_cooldown(
    callback: CallbackQuery,
) -> bool:
    user_id = callback.from_user.id
    callback_data = callback.data or ""

    current_time = time.monotonic()

    cooldown_key = (
        user_id,
        callback_data,
    )

    last_time = callback_cooldowns.get(
        cooldown_key,
    )

    if (
        last_time is not None
        and current_time - last_time < CALLBACK_COOLDOWN
    ):
        try:
            await callback.answer()

        except TelegramBadRequest as error:
            error_text = str(error).lower()

            if (
                "query is too old" in error_text
                or "query id is invalid" in error_text
                or "response timeout expired" in error_text
            ):
                return False

            raise

        return False

    callback_cooldowns[cooldown_key] = current_time
    return True


# =========================
# УПРАВЛЕНИЕ ТАЙМЕРОМ
# =========================

async def cancel_search_timer(
    user_id: int,
    delete_message: bool = True,
) -> None:
    task = search_timer_tasks.pop(
        user_id,
        None,
    )

    if task is not None and not task.done():
        task.cancel()

    timer_message = search_timer_messages.pop(
        user_id,
        None,
    )

    if timer_message is None or not delete_message:
        return

    try:
        await timer_message.delete()

    except TelegramBadRequest:
        pass

    except Exception:
        logger.exception(
            "Ошибка удаления сообщения таймера"
        )


def get_timer_interface(
    remaining: int,
    animation_step: int,
) -> str:
    minutes = remaining // 60
    seconds = remaining % 60

    indicators = [
        "● ○ ○ ○",
        "● ● ○ ○",
        "● ● ● ○",
        "● ● ● ●",
    ]

    indicator = indicators[
        animation_step % len(indicators)
    ]

    if remaining <= 20:
        status = (
            "⚠️ <b>Время почти вышло</b>\n\n"
            "Отправьте данные, чтобы продолжить поиск."
        )

    elif remaining <= 120:
        status = (
            "🟡 <b>Ожидание поискового запроса</b>\n\n"
            "Данные ещё не получены."
        )

    else:
        status = (
            "⏳ <b>Ожидание поискового запроса</b>\n\n"
            "Введите данные для начала поиска."
        )

    return (
        f"{status}\n\n"
        f"{indicator}\n\n"
        f"⏱ <b>Осталось:</b> "
        f"{minutes:02d}:{seconds:02d}"
    )


async def start_search_timer(
    message: Message,
    state: FSMContext,
    user_id: int,
) -> None:
    await cancel_search_timer(user_id)

    timer_message = await message.answer(
        get_timer_interface(
            remaining=SEARCH_INPUT_TIMEOUT,
            animation_step=0,
        ),
        parse_mode="HTML",
        reply_markup=get_back_keyboard(),
    )

    search_timer_messages[user_id] = timer_message

    async def timer() -> None:
        remaining = SEARCH_INPUT_TIMEOUT
        animation_step = 0

        try:
            while remaining > 0:
                await asyncio.sleep(
                    SEARCH_TIMER_UPDATE_INTERVAL
                )

                remaining -= SEARCH_TIMER_UPDATE_INTERVAL
                animation_step += 1

                current_state = await state.get_state()

                if current_state not in {
                    OsintSearchState.waiting_for_phone.state,
                    OsintSearchState.waiting_for_username.state,
                    OsintSearchState.waiting_for_telegram_id.state,
                }:
                    return

                if remaining <= 0:
                    await state.clear()

                    search_timer_messages.pop(
                        user_id,
                        None,
                    )

                    try:
                        await timer_message.edit_text(
                            (
                                "⌛ <b>Время ожидания истекло</b>\n\n"
                                "Поисковый запрос не был получен.\n\n"
                                "Выберите формат поиска заново."
                            ),
                            parse_mode="HTML",
                            reply_markup=(
                                get_search_type_keyboard()
                            ),
                        )

                    except TelegramBadRequest as error:
                        if (
                            "message is not modified"
                            not in str(error).lower()
                        ):
                            raise

                    return

                try:
                    await timer_message.edit_text(
                        get_timer_interface(
                            remaining=remaining,
                            animation_step=animation_step,
                        ),
                        parse_mode="HTML",
                        reply_markup=get_back_keyboard(),
                    )

                except TelegramBadRequest as error:
                    if (
                        "message is not modified"
                        not in str(error).lower()
                    ):
                        raise

        except asyncio.CancelledError:
            return

        except Exception:
            logger.exception(
                "Ошибка таймера ожидания поиска"
            )

        finally:
            current_task = search_timer_tasks.get(
                user_id,
            )

            if current_task is asyncio.current_task():
                search_timer_tasks.pop(
                    user_id,
                    None,
                )

    task = asyncio.create_task(timer())

    search_timer_tasks[user_id] = task


