def validate_phone(
    value: str,
) -> tuple[bool, str]:
    phone = value.strip()

    if phone.startswith("+"):
        phone = phone[1:]

    if not phone:
        return (
            False,
            "⚠️ Номер телефона не указан.",
        )

    if not phone.isdigit():
        return (
            False,
            "⚠️ Неверный формат номера.\n\n"
            "Номер должен содержать только цифры.",
        )

    if len(phone) < PHONE_MIN_LENGTH:
        return (
            False,
            "⚠️ Недопустимая длина номера.\n\n"
            f"Минимум: {PHONE_MIN_LENGTH} цифр.",
        )

    if len(phone) > PHONE_MAX_LENGTH:
        return (
            False,
            "⚠️ Недопустимая длина номера.\n\n"
            f"Максимум: {PHONE_MAX_LENGTH} цифр.",
        )

    return True, phone


# =========================
# ВАЛИДАЦИЯ USERNAME
# =========================

def validate_username(
    value: str,
) -> tuple[bool, str]:
    username = value.strip()

    if username.startswith("@"):
        username = username[1:]

    if not username:
        return (
            False,
            "⚠️ Username не указан.",
        )

    if username.startswith("@"):
        return (
            False,
            "⚠️ Неверный формат username.\n\n"
            "Используйте только один символ @ в начале.",
        )

    if len(username) < USERNAME_MIN_LENGTH:
        return (
            False,
            "⚠️ Недопустимая длина username.\n\n"
            f"Минимум: {USERNAME_MIN_LENGTH} символов.",
        )

    if len(username) > USERNAME_MAX_LENGTH:
        return (
            False,
            "⚠️ Недопустимая длина username.\n\n"
            f"Максимум: {USERNAME_MAX_LENGTH} символа.",
        )

    if not re.fullmatch(
        r"[A-Za-z0-9_]+",
        username,
    ):
        return (
            False,
            "⚠️ Неверный формат username.\n\n"
            "Допустимы только латинские буквы, "
            "цифры и символ подчёркивания.",
        )

    return True, username


# =========================
