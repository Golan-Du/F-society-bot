def get_search_result_text(
    search_type: str,
    search_value: str,
    record_found: bool,
) -> str:
    if record_found:
        status = "🟢 Данные обнаружены"
        sources = random.randint(1, 5)
        matches = random.randint(1, 3)

        details = (
            "📥 Найденные данные временно "
            "имитируются."
        )
    else:
        status = "🟡 Данные не обнаружены"
        sources = random.randint(3, 8)
        matches = 0

        details = (
            "🌐 Открытые источники проверены.\n"
            "Совпадений пока не найдено."
        )

    return (
        "🔎 <b>OSINT-сканер</b>\n\n"
        f"{search_type}: "
        f"<code>{search_value}</code>\n\n"
        "📊 <b>Результат анализа</b>\n\n"
        f"🗂 <b>Статус:</b> {status}\n"
        f"🔍 <b>Проверено источников:</b> {sources}\n"
        f"🧩 <b>Совпадений:</b> {matches}\n\n"
        "━━━━━━━━━━━━\n"
        f"{details}\n\n"
        "⚙️ <i>Реальные источники будут "
        "подключены позже.</i>"
    )


async def run_scan(
    message: Message,
    search_type: str,
    search_value: str,
) -> None:
    progress_message = await message.answer(
        (
            "🔎 <b>OSINT-сканер</b>\n\n"
            f"{search_type}: "
            f"<code>{search_value}</code>\n\n"
            "📡 Подключение к источникам •"
        ),
        parse_mode="HTML",
    )

    def get_progress_text(
        status: str,
    ) -> str:
        return (
            "🔎 <b>OSINT-сканер</b>\n\n"
            f"{search_type}: "
            f"<code>{search_value}</code>\n\n"
            f"{status}"
        )

    async def update_progress(
        status: str,
        delay: float,
    ) -> None:
        await asyncio.sleep(delay)

        try:
            await progress_message.edit_text(
                get_progress_text(status),
                parse_mode="HTML",
            )

        except TelegramBadRequest as error:
            if (
                "message is not modified"
                not in str(error).lower()
            ):
                raise

    try:
        await update_progress(
            "🗄 Проверка базы данных ••",
            0.8,
        )

        await asyncio.sleep(1.2)

        record_found = random.choice(
            [True, False]
        )

        if record_found:
            await progress_message.edit_text(
                get_progress_text(
                    "📥 Получение данных •••"
                ),
                parse_mode="HTML",
            )

            await asyncio.sleep(1.5)

        else:
            await progress_message.edit_text(
                get_progress_text(
                    "🌐 Поиск по открытым источникам •••"
                ),
                parse_mode="HTML",
            )

            await asyncio.sleep(2.0)

        await progress_message.edit_text(
            get_progress_text(
                "🧩 Анализ совпадений ••••"
            ),
            parse_mode="HTML",
        )

        await asyncio.sleep(1.0)

        await progress_message.edit_text(
            get_search_result_text(
                search_type=search_type,
                search_value=search_value,
                record_found=record_found,
            ),
            parse_mode="HTML",
            reply_markup=get_result_keyboard(),
        )

    except Exception:
        logger.exception(
            "Ошибка выполнения OSINT-поиска"
        )

        try:
            await progress_message.edit_text(
                (
                    "⚠️ Во время обработки запроса "
                    "произошла ошибка."
                ),
                reply_markup=get_result_keyboard(),
            )

        except TelegramBadRequest:
            pass


